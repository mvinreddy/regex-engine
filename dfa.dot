digraph DFA {
  rankdir=LR;
  s0 [shape=circle];
  s1 [shape=circle];
  s2 [shape=circle];
  s3 [shape=doublecircle];
  start [shape=point];
  start -> s0;
  s0 -> s0 [label="b"];
  s0 -> s1 [label="a"];
  s1 -> s1 [label="a"];
  s1 -> s2 [label="b"];
  s2 -> s1 [label="a"];
  s2 -> s3 [label="b"];
  s3 -> s0 [label="b"];
  s3 -> s1 [label="a"];
}

